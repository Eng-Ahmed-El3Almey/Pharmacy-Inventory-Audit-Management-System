<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Visual Studio inspired blue theme: cool surfaces, restrained blue accent. -->
    <Color x:Key="WindowBackgroundColor">#EFF4FA</Color>
    <Color x:Key="SidebarBackgroundColor">#E5EEF8</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="TitleBarBackgroundColor">#0078D4</Color>
    <Color x:Key="InputBackgroundColor">#F8FAFD</Color>
    <Color x:Key="BorderColor">#D2DCE9</Color>
    <Color x:Key="SecondarySurfaceColor">#EAF0F7</Color>
    <Color x:Key="TableHeaderColor">#0078D4</Color>

    <Color x:Key="HeaderTextColor">#17304F</Color>
    <Color x:Key="TitleBarTextColor">#FFFFFF</Color>
    <Color x:Key="BodyTextColor">#40536B</Color>
    <Color x:Key="MutedTextColor">#72849A</Color>
    <Color x:Key="MutedAltColor">#64778F</Color>

    <Color x:Key="AccentColor">#0078D4</Color>
    <Color x:Key="AccentHoverColor">#106EBE</Color>
    <Color x:Key="AccentSoftColor">#E3F1FF</Color>

    <Color x:Key="PositiveBackColor">#E8F7EF</Color>
    <Color x:Key="PositiveTextColor">#148653</Color>
    <Color x:Key="WarningBackColor">#FFF5DE</Color>
    <Color x:Key="WarningTextColor">#A96F0C</Color>
    <Color x:Key="NegativeBackColor">#FCE9EB</Color>
    <Color x:Key="NegativeTextColor">#C83D4C</Color>
    <Color x:Key="InfoBackColor">#E5F1FF</Color>
    <Color x:Key="InfoTextColor">#1769AA</Color>
    <Color x:Key="PurpleBackColor">#F0EBFF</Color>
    <Color x:Key="PurpleTextColor">#6F4CB8</Color>

    <Color x:Key="SidebarTextColor">#3F536A</Color>
    <Color x:Key="SidebarHoverColor">#D4E7FA</Color>
    <Color x:Key="ToggleOffBackgroundColor">#E0E7EF</Color>
    <Color x:Key="ToggleOffBorderColor">#C3CFDC</Color>
    <Color x:Key="ToggleOffTextColor">#687B91</Color>
    <Color x:Key="CalendarHoverColor">#E3F1FF</Color>
    <Color x:Key="CloseHoverColor">#D9485A</Color>
    <Color x:Key="DangerColor">#D94B57</Color>
    <Color x:Key="OnlineDotColor">#239C63</Color>
    <Color x:Key="SuccessColor">#1D9860</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <Color x:Key="OverlayColor">#660A1A2F</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{StaticResource TitleBarBackgroundColor}" />
    <SolidColorBrush x:Key="TitleBarTextBrush" Color="{StaticResource TitleBarTextColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SecondarySurfaceBrush" Color="{StaticResource SecondarySurfaceColor}" />
    <SolidColorBrush x:Key="TableHeaderBrush" Color="{StaticResource TableHeaderColor}" />
    <SolidColorBrush x:Key="HeaderTextBrush" Color="{StaticResource HeaderTextColor}" />
    <SolidColorBrush x:Key="BodyTextBrush" Color="{StaticResource BodyTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="MutedAltBrush" Color="{StaticResource MutedAltColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="PositiveBackBrush" Color="{StaticResource PositiveBackColor}" />
    <SolidColorBrush x:Key="PositiveTextBrush" Color="{StaticResource PositiveTextColor}" />
    <SolidColorBrush x:Key="WarningBackBrush" Color="{StaticResource WarningBackColor}" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningTextColor}" />
    <SolidColorBrush x:Key="NegativeBackBrush" Color="{StaticResource NegativeBackColor}" />
    <SolidColorBrush x:Key="NegativeTextBrush" Color="{StaticResource NegativeTextColor}" />
    <SolidColorBrush x:Key="InfoBackBrush" Color="{StaticResource InfoBackColor}" />
    <SolidColorBrush x:Key="InfoTextBrush" Color="{StaticResource InfoTextColor}" />
    <SolidColorBrush x:Key="PurpleBackBrush" Color="{StaticResource PurpleBackColor}" />
    <SolidColorBrush x:Key="PurpleTextBrush" Color="{StaticResource PurpleTextColor}" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
    <SolidColorBrush x:Key="ToggleOffBackgroundBrush" Color="{StaticResource ToggleOffBackgroundColor}" />
    <SolidColorBrush x:Key="ToggleOffBorderBrush" Color="{StaticResource ToggleOffBorderColor}" />
    <SolidColorBrush x:Key="ToggleOffTextBrush" Color="{StaticResource ToggleOffTextColor}" />
    <SolidColorBrush x:Key="CalendarHoverBrush" Color="{StaticResource CalendarHoverColor}" />
    <SolidColorBrush x:Key="WindowButtonHoverBrush" Color="#2A8FE6" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="{StaticResource CloseHoverColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />
    <SolidColorBrush x:Key="OnlineDotBrush" Color="{StaticResource SuccessColor}" />

    <!-- Bottom status bar -->
    <Color x:Key="StatusBarBackgroundColor">#E2ECF7</Color>
    <Color x:Key="StatusBarPrimaryTextColor">#17304F</Color>
    <Color x:Key="StatusBarSecondaryTextColor">#60738A</Color>
    <Color x:Key="StatusBarSeparatorColor">#C2D2E6</Color>
    <Color x:Key="StatusBarHoverColor">#D1E5FA</Color>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="{StaticResource StatusBarBackgroundColor}" />
    <SolidColorBrush x:Key="StatusBarPrimaryTextBrush" Color="{StaticResource StatusBarPrimaryTextColor}" />
    <SolidColorBrush x:Key="StatusBarSecondaryTextBrush" Color="{StaticResource StatusBarSecondaryTextColor}" />
    <SolidColorBrush x:Key="StatusBarSeparatorBrush" Color="{StaticResource StatusBarSeparatorColor}" />
    <SolidColorBrush x:Key="StatusBarHoverBrush" Color="{StaticResource StatusBarHoverColor}" />

    <SolidColorBrush x:Key="RowAltBrush" Color="#F8FAFD" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#EEF5FC" />
    <SolidColorBrush x:Key="RowHoverAccentBrush" Color="#0078D4" Opacity="0.10" />
    <SolidColorBrush x:Key="SelectedCellBrush" Color="#D5E9FA" />
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#E4F1FC" />
</ResourceDictionary>
