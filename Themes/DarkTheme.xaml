<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Original application dark theme -->
    <Color x:Key="WindowBackgroundColor">#0B1B33</Color>
    <Color x:Key="SidebarBackgroundColor">#0E2141</Color>
    <Color x:Key="CardBackgroundColor">#122A4D</Color>
    <Color x:Key="TitleBarBackgroundColor">#0B1B33</Color>
    <Color x:Key="InputBackgroundColor">#0E2141</Color>
    <Color x:Key="BorderColor">#1E3A5F</Color>

    <Color x:Key="HeaderTextColor">#F8FAFC</Color>
    <Color x:Key="TitleBarTextColor">#F8FAFC</Color>
    <Color x:Key="BodyTextColor">#D6E0F0</Color>
    <Color x:Key="MutedTextColor">#7E93B8</Color>

    <Color x:Key="AccentColor">#2F6FED</Color>
    <Color x:Key="AccentHoverColor">#4C85F5</Color>

    <Color x:Key="PositiveBackColor">#173B2C</Color>
    <Color x:Key="PositiveTextColor">#3ED98A</Color>
    <Color x:Key="WarningBackColor">#463714</Color>
    <Color x:Key="WarningTextColor">#F0B93E</Color>
    <Color x:Key="NegativeBackColor">#4A2027</Color>
    <Color x:Key="NegativeTextColor">#F26D75</Color>
    <Color x:Key="OnlineDotColor">#3ED98A</Color>

    <!-- Compatibility aliases used by the newer screens -->
    <Color x:Key="SecondarySurfaceColor">#0E2141</Color>
    <Color x:Key="TableHeaderColor">#1E3A5F</Color>
    <Color x:Key="MutedAltColor">#6F86AA</Color>
    <Color x:Key="AccentSoftColor">#17335C</Color>
    <Color x:Key="InfoBackColor">#18355F</Color>
    <Color x:Key="InfoTextColor">#78A7F7</Color>
    <Color x:Key="PurpleBackColor">#332B58</Color>
    <Color x:Key="PurpleTextColor">#B7A4F4</Color>
    <Color x:Key="SidebarTextColor">#C7D4E8</Color>
    <Color x:Key="SidebarHoverColor">#17335C</Color>
    <Color x:Key="ToggleOffBackgroundColor">#122A4D</Color>
    <Color x:Key="ToggleOffBorderColor">#40597D</Color>
    <Color x:Key="ToggleOffTextColor">#7E93B8</Color>
    <Color x:Key="CalendarHoverColor">#17335C</Color>
    <Color x:Key="CloseHoverColor">#D9485A</Color>
    <Color x:Key="DangerColor">#E05260</Color>
    <Color x:Key="SuccessColor">#3ED98A</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <Color x:Key="OverlayColor">#990B1B33</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{StaticResource TitleBarBackgroundColor}" />
    <SolidColorBrush x:Key="TitleBarTextBrush" Color="{StaticResource TitleBarTextColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SecondarySurfaceBrush" Color="{StaticResource SecondarySurfaceColor}" />
    <SolidColorBrush x:Key="TableHeaderBrush" Color="{StaticResource TableHeaderColor}" />
    <SolidColorBrush x:Key="HeaderTextBrush" Color="{StaticResource HeaderTextColor}" />
    <SolidColorBrush x:Key="BodyTextBrush" Color="{StaticResource BodyTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="MutedAltBrush" Color="{StaticResource MutedAltColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="PositiveBackBrush" Color="{StaticResource PositiveBackColor}" />
    <SolidColorBrush x:Key="PositiveTextBrush" Color="{StaticResource PositiveTextColor}" />
    <SolidColorBrush x:Key="WarningBackBrush" Color="{StaticResource WarningBackColor}" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningTextColor}" />
    <SolidColorBrush x:Key="NegativeBackBrush" Color="{StaticResource NegativeBackColor}" />
    <SolidColorBrush x:Key="NegativeTextBrush" Color="{StaticResource NegativeTextColor}" />
    <SolidColorBrush x:Key="InfoBackBrush" Color="{StaticResource InfoBackColor}" />
    <SolidColorBrush x:Key="InfoTextBrush" Color="{StaticResource InfoTextColor}" />
    <SolidColorBrush x:Key="PurpleBackBrush" Color="{StaticResource PurpleBackColor}" />
    <SolidColorBrush x:Key="PurpleTextBrush" Color="{StaticResource PurpleTextColor}" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
    <SolidColorBrush x:Key="ToggleOffBackgroundBrush" Color="{StaticResource ToggleOffBackgroundColor}" />
    <SolidColorBrush x:Key="ToggleOffBorderBrush" Color="{StaticResource ToggleOffBorderColor}" />
    <SolidColorBrush x:Key="ToggleOffTextBrush" Color="{StaticResource ToggleOffTextColor}" />
    <SolidColorBrush x:Key="CalendarHoverBrush" Color="{StaticResource CalendarHoverColor}" />
    <SolidColorBrush x:Key="WindowButtonHoverBrush" Color="#203A5C" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="{StaticResource CloseHoverColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />
    <SolidColorBrush x:Key="OnlineDotBrush" Color="{StaticResource OnlineDotColor}" />

    <!-- Bottom status bar -->
    <Color x:Key="StatusBarBackgroundColor">#0E2141</Color>
    <Color x:Key="StatusBarPrimaryTextColor">#F8FAFC</Color>
    <Color x:Key="StatusBarSecondaryTextColor">#C7D4E8</Color>
    <Color x:Key="StatusBarSeparatorColor">#355173</Color>
    <Color x:Key="StatusBarHoverColor">#17335C</Color>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="{StaticResource StatusBarBackgroundColor}" />
    <SolidColorBrush x:Key="StatusBarPrimaryTextBrush" Color="{StaticResource StatusBarPrimaryTextColor}" />
    <SolidColorBrush x:Key="StatusBarSecondaryTextBrush" Color="{StaticResource StatusBarSecondaryTextColor}" />
    <SolidColorBrush x:Key="StatusBarSeparatorBrush" Color="{StaticResource StatusBarSeparatorColor}" />
    <SolidColorBrush x:Key="StatusBarHoverBrush" Color="{StaticResource StatusBarHoverColor}" />

    <SolidColorBrush x:Key="RowAltBrush" Color="#0E2141" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#17335C" />
    <SolidColorBrush x:Key="RowHoverAccentBrush" Color="#2F6FED" Opacity="0.22" />
    <SolidColorBrush x:Key="SelectedCellBrush" Color="#214A82" />
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#193B6A" />
</ResourceDictionary>
