<Window x:Class="PharmacyInventorySystem.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add User"
        Width="720"
        Height="760"
        MinWidth="650"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        AllowsTransparency="False"
        SourceInitialized="UserManagementWindow_SourceInitialized"
        ShowInTaskbar="False">


    <Window.Resources>
        <Style x:Key="EditorInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EditorPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EditorComboStyle" TargetType="ComboBox" BasedOn="{StaticResource RoundedComboBoxStyle}">
            <Setter Property="Height" Value="42"/>
        </Style>

        <Style x:Key="EditorDateComboStyle" TargetType="ComboBox" BasedOn="{StaticResource RoundedComboBoxStyle}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="EditorLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="1,0,0,6"/>
        </Style>

        <Style x:Key="AccountToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" Width="52" Height="28" CornerRadius="14"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"/>
                            <Ellipse x:Name="Thumb" Width="22" Height="22" Margin="4,0,0,0"
                                     HorizontalAlignment="Left" Fill="{DynamicResource MutedTextBrush}"/>
                            <ContentPresenter Margin="64,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="26,0,0,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorPasswordVisibilityButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PermissionCheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="5"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
                                <TextBlock x:Name="Mark" Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="0"
            CornerRadius="16"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush2}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="24,20,18,14"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource AccentBrush}"
                            Margin="0,0,10,0">
                        <TextBlock Text="&#xE77B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource OnAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Text="Add New User"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource HeaderTextBrush}"/>
                        <TextBlock x:Name="SubtitleText"
                                   Text="Create a user account and assign permissions"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets"
                        Width="34"
                        Height="34"
                        HorizontalAlignment="Right"
                        Style="{StaticResource WindowControlButtonStyle}"
                        Click="Close_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,0,24,8">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Account Information"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource HeaderTextBrush}"
                                       Margin="0,0,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                                    <TextBlock Text="Username *" Style="{StaticResource EditorLabelStyle}"/>
                                    <TextBox x:Name="UsernameBox" Style="{StaticResource EditorInputStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,12">
                                    <TextBlock Text="Full Name *" Style="{StaticResource EditorLabelStyle}"/>
                                    <TextBox x:Name="FullNameBox" Style="{StaticResource EditorInputStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
                                    <TextBlock Text="Password" Style="{StaticResource EditorLabelStyle}"/>
                                    <Grid Height="42">
                                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource EditorPasswordStyle}" Padding="12,0,42,0"/>
                                        <TextBox x:Name="PasswordTextBox" Style="{StaticResource EditorInputStyle}" Padding="12,0,42,0" Visibility="Collapsed"/>
                                        <Button x:Name="PasswordVisibilityButton"
                                                Content="&#xE890;"
                                                Style="{StaticResource EditorPasswordVisibilityButtonStyle}"
                                                HorizontalAlignment="Right"
                                                Margin="0,2,2,2"
                                                ToolTip="Show password"
                                                Click="PasswordVisibility_Click"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,12">
                                    <TextBlock Text="Confirm Password" Style="{StaticResource EditorLabelStyle}"/>
                                    <Grid Height="42">
                                        <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource EditorPasswordStyle}" Padding="12,0,42,0"/>
                                        <TextBox x:Name="ConfirmPasswordTextBox" Style="{StaticResource EditorInputStyle}" Padding="12,0,42,0" Visibility="Collapsed"/>
                                        <Button x:Name="ConfirmPasswordVisibilityButton"
                                                Content="&#xE890;"
                                                Style="{StaticResource EditorPasswordVisibilityButtonStyle}"
                                                HorizontalAlignment="Right"
                                                Margin="0,2,2,2"
                                                ToolTip="Show password"
                                                Click="ConfirmPasswordVisibility_Click"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,12">
                                    <TextBlock Text="Email" Style="{StaticResource EditorLabelStyle}"/>
                                    <TextBox x:Name="EmailBox" Style="{StaticResource EditorInputStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,12">
                                    <TextBlock Text="Mobile Number" Style="{StaticResource EditorLabelStyle}"/>
                                    <TextBox x:Name="MobileBox" Style="{StaticResource EditorInputStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,12">
                                    <TextBlock Text="Gender" Style="{StaticResource EditorLabelStyle}"/>
                                    <ComboBox x:Name="GenderBox" Style="{StaticResource EditorComboStyle}">
                                        <ComboBoxItem Content="Male"/>
                                        <ComboBoxItem Content="Female"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,12">
                                    <TextBlock Text="Date of Birth" Style="{StaticResource EditorLabelStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="1.25*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="BirthDayBox" Grid.Column="0"
                                                  Style="{StaticResource EditorDateComboStyle}"
                                                  ToolTip="Day"/>
                                        <ComboBox x:Name="BirthMonthBox" Grid.Column="2"
                                                  Style="{StaticResource EditorDateComboStyle}"
                                                  ToolTip="Month"/>
                                        <ComboBox x:Name="BirthYearBox" Grid.Column="4"
                                                  Style="{StaticResource EditorDateComboStyle}"
                                                  ToolTip="Year"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Role *" Style="{StaticResource EditorLabelStyle}"/>
                                    <ComboBox x:Name="RoleBox" Style="{StaticResource EditorComboStyle}">
                                        <ComboBoxItem Content="Administrator"/>
                                        <ComboBoxItem Content="Manager"/>
                                        <ComboBoxItem Content="Auditor"/>
                                        <ComboBoxItem Content="Pharmacist"/>
                                        <ComboBoxItem Content="Staff"/>
                                        <ComboBoxItem Content="Viewer"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Account Status" Style="{StaticResource EditorLabelStyle}"/>
                                    <ToggleButton x:Name="ActiveBox"
                                                  Content="Active account"
                                                  IsChecked="True"
                                                  Style="{StaticResource AccountToggleStyle}"
                                                  Height="42"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Permissions"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource HeaderTextBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Choose the areas this user can access"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <UniformGrid Columns="2">
                                <CheckBox x:Name="ViewInventoryBox" Content="View Inventory" Style="{StaticResource PermissionCheckStyle}"/>
                                <CheckBox x:Name="ImportInventoryBox" Content="Import Inventory" Style="{StaticResource PermissionCheckStyle}"/>
                                <CheckBox x:Name="ViewReportsBox" Content="View Reports" Style="{StaticResource PermissionCheckStyle}"/>
                                <CheckBox x:Name="DeleteReportsBox" Content="Delete Reports" Style="{StaticResource PermissionCheckStyle}"/>
                                <CheckBox x:Name="EditReportsBox" Content="Edit Reports" Style="{StaticResource PermissionCheckStyle}"/>
                                <CheckBox x:Name="UserManagementBox" Content="User Management" Style="{StaticResource PermissionCheckStyle}"/>
                                <CheckBox x:Name="ManageCategoriesBox" Content="Manage Categories" Style="{StaticResource PermissionCheckStyle}"/>
                            </UniformGrid>

                            <Border x:Name="ErrorPanel"
                                    Background="{DynamicResource NegativeBackBrush}"
                                    BorderBrush="{DynamicResource NegativeTextBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,2,0,0"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="ErrorText"
                                           FontSize="12"
                                           Foreground="{DynamicResource NegativeTextBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource BorderBrush2}"
                    BorderThickness="0,1,0,0"
                    Padding="24,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#xE74D;  Clear"
                            FontFamily="Segoe UI, Segoe MDL2 Assets"
                            Width="105"
                            Style="{StaticResource PillButtonBase}"
                            Background="{DynamicResource InputBackgroundBrush}"
                            Foreground="{DynamicResource BodyTextBrush}"
                            BorderBrush="{DynamicResource BorderBrush2}"
                            Click="Clear_Click"/>
                    <Button Content="Cancel"
                            Width="100"
                            Margin="10,0,0,0"
                            Style="{StaticResource PillButtonBase}"
                            Background="{DynamicResource InputBackgroundBrush}"
                            Foreground="{DynamicResource BodyTextBrush}"
                            BorderBrush="{DynamicResource BorderBrush2}"
                            Click="Close_Click"/>
                    <Button Content="&#xE73E;  Save User"
                            FontFamily="Segoe UI, Segoe MDL2 Assets"
                            Width="125"
                            Margin="10,0,0,0"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
