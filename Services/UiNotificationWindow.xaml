<Window x:Class="PharmacyInventorySystem.Services.UiNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        SizeToContent="WidthAndHeight"
        MinWidth="460"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner">

    <Border Margin="10"
            Padding="22"
            CornerRadius="16"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush2}"
            BorderThickness="1">

        <Grid Width="480">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="36"
                        Height="36"
                        CornerRadius="18"
                        Background="{Binding IconBackgroundBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding IconText}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource OnAccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock Grid.Column="1"
                           Text="{Binding Caption}"
                           Margin="12,0,0,0"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource HeaderTextBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <Button Grid.Column="2"
                        Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets"
                        Width="32"
                        Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource MutedTextBrush}"
                        Click="Close_Click" />
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{Binding Message}"
                       Margin="56,18,10,22"
                       FontSize="14"
                       Foreground="{DynamicResource BodyTextBrush}"
                       TextWrapping="Wrap"
                       MaxWidth="410" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="OkButton"
                        Content="OK"
                        Width="100"
                        Height="40"
                        Margin="0,0,0,0"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Ok_Click" />

                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Width="100"
                        Height="40"
                        Margin="10,0,0,0"
                        Style="{StaticResource PillButtonBase}"
                        Background="{DynamicResource InputBackgroundBrush}"
                        Foreground="{DynamicResource BodyTextBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}"
                        Click="Cancel_Click"
                        Visibility="Collapsed" />

                <Button x:Name="YesButton"
                        Content="Yes"
                        Width="100"
                        Height="40"
                        Margin="0,0,0,0"
                        Style="{StaticResource SuccessButtonStyle}"
                        Click="Yes_Click"
                        Visibility="Collapsed" />

                <Button x:Name="NoButton"
                        Content="No"
                        Width="100"
                        Height="40"
                        Margin="10,0,0,0"
                        Style="{StaticResource PillButtonBase}"
                        Background="{DynamicResource InputBackgroundBrush}"
                        Foreground="{DynamicResource BodyTextBrush}"
                        Click="No_Click"
                        Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
