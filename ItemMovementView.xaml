<UserControl x:Class="PharmacyInventorySystem.ItemMovementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        </Style>

        <Style x:Key="MovementFilterTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MovementFilterComboStyle" TargetType="ComboBox" BasedOn="{StaticResource RoundedComboBoxStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>

        <Style x:Key="MovementDateTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MovementFilterTextBoxStyle}">
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="MovementDataGrid" TargetType="DataGrid" BasedOn="{StaticResource ThemedDataGrid}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="50"/>
            <Setter Property="ColumnHeaderHeight" Value="44"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style x:Key="MovementHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource TableHeaderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="MovementRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHoverAccentBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHoverAccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MovementCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MovementTypeBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        </Style>

        <DataTemplate x:Key="MovementTypeTemplate">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource MovementTypeBadge}">
                        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MovementType}" Value="IN">
                                <Setter Property="Background" Value="{DynamicResource PositiveBackBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MovementType}" Value="OUT">
                                <Setter Property="Background" Value="{DynamicResource NegativeBackBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MovementType}" Value="ADJ">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MovementType}" Value="TRF">
                                <Setter Property="Background" Value="{DynamicResource PurpleBackBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding MovementType}"
                           FontWeight="Bold"
                           FontSize="11"
                           Foreground="{DynamicResource OnAccentBrush}"
                           HorizontalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,20">

                <!-- Page header -->
                <Grid Margin="0,0,0,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38"
                                    Height="38"
                                    CornerRadius="11"
                                    Background="{DynamicResource AccentBrush}"
                                    Margin="0,0,12,0">
                                <TextBlock Text="&#xE8BC;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{DynamicResource OnAccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Item Movement"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource HeaderTextBrush}"/>
                                <TextBlock Text="Track and monitor all stock movements, adjustments and transfers"
                                           FontSize="13"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource PillButtonBase}"
                            Background="{DynamicResource InputBackgroundBrush}"
                            Foreground="{DynamicResource BodyTextBrush}"
                            BorderBrush="{DynamicResource BorderBrush2}"
                            Padding="14,9"
                            Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Margin="0,0,7,0"/>
                            <TextBlock Text="Refresh"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Filters -->
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="2.1*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="From Date" Style="{StaticResource FilterLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="To Date" Style="{StaticResource FilterLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Branch" Style="{StaticResource FilterLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Warehouse" Style="{StaticResource FilterLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Movement Type" Style="{StaticResource FilterLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="5" Text="Search" Style="{StaticResource FilterLabelStyle}"/>

                        <TextBox x:Name="FromDateBox" Grid.Row="1" Grid.Column="0" Margin="0,6,8,0" Style="{StaticResource MovementDateTextBoxStyle}" Text=""/>
                        <TextBox x:Name="ToDateBox" Grid.Row="1" Grid.Column="1" Margin="0,6,8,0" Style="{StaticResource MovementDateTextBoxStyle}" Text=""/>
                        <ComboBox x:Name="BranchBox" Grid.Row="1" Grid.Column="2" Margin="0,6,8,0" Style="{StaticResource MovementFilterComboStyle}" SelectionChanged="FilterChanged">
                            <ComboBoxItem Content="All Branches" IsSelected="True"/>
                        </ComboBox>
                        <ComboBox x:Name="WarehouseBox" Grid.Row="1" Grid.Column="3" Margin="0,6,8,0" Style="{StaticResource MovementFilterComboStyle}" SelectionChanged="FilterChanged">
                            <ComboBoxItem Content="All Warehouses" IsSelected="True"/>
                        </ComboBox>
                        <ComboBox x:Name="MovementTypeBox" Grid.Row="1" Grid.Column="4" Margin="0,6,8,0" Style="{StaticResource MovementFilterComboStyle}" SelectionChanged="FilterChanged">
                            <ComboBoxItem Content="All Types" IsSelected="True"/>
                            <ComboBoxItem Content="IN"/>
                            <ComboBoxItem Content="OUT"/>
                            <ComboBoxItem Content="ADJ"/>
                            <ComboBoxItem Content="TRF"/>
                        </ComboBox>
                        <Border Grid.Row="1" Grid.Column="5"
                                Margin="0,6,0,0"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="40">
                            <Grid>
                                <TextBlock Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                                <TextBox x:Name="SearchBox"
                                         Margin="34,0,8,0"
                                         Style="{StaticResource RoundedTextBoxStyle}"
                                         TextChanged="SearchBox_TextChanged"
                                         ToolTip="Search by product code or product name"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI cards -->
                <UniformGrid Columns="5" Margin="0,0,0,16">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0" Padding="15">
                        <StackPanel>
                            <TextBlock Text="TOTAL IN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PositiveTextBrush}"/>
                            <TextBlock x:Name="TotalInText" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HeaderTextBrush}" Margin="0,7,0,0"/>
                            <TextBlock Text="Incoming stock" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="6,0" Padding="15">
                        <StackPanel>
                            <TextBlock Text="TOTAL OUT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NegativeTextBrush}"/>
                            <TextBlock x:Name="TotalOutText" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HeaderTextBrush}" Margin="0,7,0,0"/>
                            <TextBlock Text="Outgoing stock" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="6,0" Padding="15">
                        <StackPanel>
                            <TextBlock Text="ADJUSTMENTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock x:Name="AdjustmentsText" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HeaderTextBrush}" Margin="0,7,0,0"/>
                            <TextBlock Text="Stock corrections" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="6,0" Padding="15">
                        <StackPanel>
                            <TextBlock Text="TRANSFERS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PurpleTextBrush}"/>
                            <TextBlock x:Name="TransfersText" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HeaderTextBrush}" Margin="0,7,0,0"/>
                            <TextBlock Text="Between locations" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="6,0,0,0" Padding="15">
                        <StackPanel>
                            <TextBlock Text="TOTAL MOVEMENTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock x:Name="TotalMovementsText" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HeaderTextBrush}" Margin="0,7,0,0"/>
                            <TextBlock Text="Filtered records" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- History + details -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="58"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="42"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="16,0">
                                <TextBlock Text="Item Movement History"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource HeaderTextBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="ResultsText"
                                           Text="0 records"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <DataGrid x:Name="MovementsGrid"
                                      Grid.Row="1"
                                      Style="{StaticResource MovementDataGrid}"
                                      ColumnHeaderStyle="{StaticResource MovementHeaderStyle}"
                                      RowStyle="{StaticResource MovementRowStyle}"
                                      CellStyle="{StaticResource MovementCellStyle}"
                                      AutoGenerateColumns="False"
                                      SelectionChanged="MovementsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="48"/>
                                    <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding DateTime, StringFormat={}{0:dd/MM/yyyy hh:mm tt}}" Width="132"/>
                                    <DataGridTextColumn Header="Product Code" Binding="{Binding ProductCode}" Width="105"/>
                                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="1.7*"/>
                                    <DataGridTemplateColumn Header="Type" Width="76" CellTemplate="{StaticResource MovementTypeTemplate}"/>
                                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat=N2}" Width="82"/>
                                    <DataGridTextColumn Header="Branch" Binding="{Binding Branch}" Width="1.15*"/>
                                    <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="105"/>
                                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="1.25*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="2" Margin="16,0">
                                <TextBlock Text="Showing filtered movement records"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource PillButtonBase}" Background="Transparent" Foreground="{DynamicResource MutedTextBrush}" Padding="8,4"/>
                                    <TextBlock Text="Page 1" Foreground="{DynamicResource BodyTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="6,0"/>
                                    <Button Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource PillButtonBase}" Background="Transparent" Foreground="{DynamicResource MutedTextBrush}" Padding="8,4"/>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="EmptyMovementOverlay" Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" Visibility="Visible">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                                    <Border Width="62" Height="62" CornerRadius="31" Background="{DynamicResource InputBackgroundBrush}">
                                        <TextBlock Text="&#xE8BC;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="24"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="No Movement Records"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource HeaderTextBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,16,0,6"/>
                                    <TextBlock Text="Movement history will appear here when item movement transactions are recorded."
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource InputBackgroundBrush}" Margin="0,0,9,0">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Movement Details" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource HeaderTextBrush}"/>
                                    <TextBlock Text="Selected transaction" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="PRODUCT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                                    <TextBlock x:Name="DetailProductName" Text="No record selected" Style="{StaticResource DetailValueStyle}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="DetailProductCode" Text="—" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,7,13">
                                    <TextBlock Text="DATE &amp; TIME" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                                    <TextBlock x:Name="DetailDate" Text="—" Style="{StaticResource DetailValueStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="7,0,0,13">
                                    <TextBlock Text="TYPE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                                    <TextBlock x:Name="DetailType" Text="—" Style="{StaticResource DetailValueStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,7,13">
                                    <TextBlock Text="QUANTITY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                                    <TextBlock x:Name="DetailQuantity" Text="—" Style="{StaticResource DetailValueStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="7,0,0,13">
                                    <TextBlock Text="BRANCH" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                                    <TextBlock x:Name="DetailBranch" Text="—" Style="{StaticResource DetailValueStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,7,13">
                                    <TextBlock Text="WAREHOUSE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                                    <TextBlock x:Name="DetailWarehouse" Text="—" Style="{StaticResource DetailValueStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="7,0,0,13">
                                    <TextBlock Text="USER" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                                    <TextBlock x:Name="DetailUser" Text="—" Style="{StaticResource DetailValueStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="NOTES" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="10" MinHeight="72">
                                <TextBlock x:Name="DetailNotes" Text="No movement selected." Foreground="{DynamicResource BodyTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
