<Window x:Class="PharmacyInventorySystem.AuditReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PharmacyInventorySystem.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Inventory Audit Report"
        Width="1500"
        Height="850"
        MinWidth="1100"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Icon="/PharmacyInventorySystem;component/Assets/PharmacyInventory.ico"
        SourceInitialized="AuditReportWindow_SourceInitialized"
        Closing="AuditReportWindow_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="12" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:DiffSignConverter x:Key="DiffSignConverter"/>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource TableHeaderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
            <Setter Property="Background" Value="{DynamicResource WarningTextBrush}"/>
        </Style>

        <Style x:Key="PdfButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        </Style>

        <Style x:Key="FilterButtonBase" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ReportActualQuantityEditBoxStyle" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBoxStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style x:Key="DifferenceCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Difference}" Value="0">
                    <Setter Property="Foreground" Value="{DynamicResource PositiveTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Difference, Converter={StaticResource DiffSignConverter}}" Value="Negative">
                    <Setter Property="Foreground" Value="{DynamicResource NegativeTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Difference, Converter={StaticResource DiffSignConverter}}" Value="Positive">
                    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="⚕" FontSize="14" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Pharmacy Inventory Audit &amp; Management System" FontSize="15" FontWeight="Bold" Margin="10,0,0,0" Foreground="{DynamicResource TitleBarTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox x:Name="ThemeSelector" Style="{StaticResource ThemeSelectorStyle}" SelectionChanged="ThemeSelector_SelectionChanged" Margin="0,0,10,0" ToolTip="Choose application theme">
                        <ComboBoxItem Content="Dark Theme"/>
                        <ComboBoxItem Content="Light Theme"/>
                        <ComboBoxItem Content="Blue Theme"/>
                    </ComboBox>
                    <Button Content="&#xE921;" Style="{StaticResource WindowControlButtonStyle}" Foreground="{DynamicResource TitleBarTextBrush}" Click="Minimize_Click"/>
                    <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource WindowControlButtonStyle}" Foreground="{DynamicResource TitleBarTextBrush}" Click="MaximizeRestore_Click"/>
                    <Button Content="&#xE8BB;" Style="{StaticResource CloseButtonStyle}" Foreground="{DynamicResource TitleBarTextBrush}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="11"
                        Background="{DynamicResource AccentBrush}"
                        Margin="0,0,12,0">
                    <TextBlock Text="&#xE9D9;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{DynamicResource OnAccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Inventory Audit"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="{DynamicResource HeaderTextBrush}"/>
                    <TextBlock x:Name="ReportSubtitleText"
                               FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="Shortage Value" Foreground="{DynamicResource NegativeTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ShortageValueText" FontSize="23" FontWeight="Bold"
                               Foreground="{DynamicResource NegativeTextBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="4,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="Surplus Value" Foreground="{DynamicResource WarningTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SurplusValueText" FontSize="23" FontWeight="Bold"
                               Foreground="{DynamicResource WarningTextBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="Net Difference" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="NetDifferenceText" FontSize="23" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="4,0,4,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Same search visual language as Home -->
                    <Border Grid.Column="0"
                            Height="40"
                            MaxWidth="430"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush2}"
                            BorderThickness="1"
                            CornerRadius="9">
                        <Grid>
                            <TextBlock Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,8,0"/>
                            <Grid Margin="36,0,10,0">
                                <TextBlock Text="Search by code, product name..."
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="SearchBox"
                                         Style="{StaticResource RoundedTextBoxStyle}"
                                         TextChanged="SearchBox_TextChanged"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Content="All" Click="FilterAll_Click"
                            Style="{StaticResource FilterButtonBase}"
                            Background="{DynamicResource AccentBrush}" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" Content="Shortage" Click="FilterShortage_Click"
                            Style="{StaticResource FilterButtonBase}"
                            Background="{DynamicResource DangerBrush}" Margin="8,0,0,0"/>
                    <Button Grid.Column="3" Content="Surplus" Click="FilterSurplus_Click"
                            Style="{StaticResource FilterButtonBase}"
                            Background="{DynamicResource WarningTextBrush}" Margin="8,0,0,0"/>
                    <Button Grid.Column="4" Content="Shortage + Surplus" Click="FilterVariance_Click"
                            Style="{StaticResource FilterButtonBase}"
                            Background="{DynamicResource PurpleTextBrush}" Margin="8,0,0,0"/>
                    <Button Grid.Column="5" Content="Exact" Click="FilterExact_Click"
                            Style="{StaticResource FilterButtonBase}"
                            Background="{DynamicResource PositiveTextBrush}" Margin="8,0,0,0"/>
                </Grid>

                <Grid DockPanel.Dock="Top" Margin="4,0,4,10">
                    <TextBlock Text="Audit Details"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource HeaderTextBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="EditReportButton"
                                Content="&#xE70F;  Edit Report"
                                Click="EditReport_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                FontFamily="Segoe UI, Segoe MDL2 Assets"
                                Height="38"
                                Padding="16,0"
                                Margin="0,0,8,0"/>
                        <Button x:Name="SaveReportChangesButton"
                                Content="&#xE74E;  Save Changes"
                                Click="SaveReportChanges_Click"
                                Style="{StaticResource SuccessButtonStyle}"
                                FontFamily="Segoe UI, Segoe MDL2 Assets"
                                Height="38"
                                Padding="16,0"
                                Margin="0,0,8,0"
                                Visibility="Collapsed"/>
                        <Button Content="&#xE8A4;  PDF"
                                Click="ExportPdf_Click"
                                Style="{StaticResource PdfButtonStyle}"
                                FontFamily="Segoe UI, Segoe MDL2 Assets"
                                Height="38"
                                Padding="16,0"
                                Margin="0,0,8,0"/>
                        <Button Content="&#xE74E;  Excel"
                                Click="ExportExcel_Click"
                                Style="{StaticResource SuccessButtonStyle}"
                                FontFamily="Segoe UI, Segoe MDL2 Assets"
                                Height="38"
                                Padding="16,0"/>
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="DetailsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="42"
                          FontSize="13"
                          Background="{DynamicResource CardBackgroundBrush}"
                          Foreground="{DynamicResource BodyTextBrush}"
                          BeginningEdit="DetailsGrid_BeginningEdit"
                          PreviewKeyDown="DetailsGrid_PreviewKeyDown"
                          PreviewMouseLeftButtonDown="DetailsGrid_PreviewMouseLeftButtonDown">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="System Quantity" Binding="{Binding SystemQuantity, StringFormat=N0}" Width="145" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Actual Quantity" Width="145" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="7" Padding="8,4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="4,2">
                                        <TextBlock Text="{Binding ActualQuantity, StringFormat=N2}"
                                                   Foreground="{DynamicResource BodyTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox x:Name="ActualQuantityEditor"
                                             Text="{Binding ActualQuantity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource ReportActualQuantityEditBoxStyle}"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center"
                                             PreviewMouseLeftButtonDown="ActualQuantityEditor_MouseLeftButtonDown"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Difference" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,4" CornerRadius="6" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Difference, Converter={StaticResource DiffSignConverter}}" Value="Negative">
                                                        <Setter Property="Background" Value="{DynamicResource NegativeBackBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Difference, Converter={StaticResource DiffSignConverter}}" Value="Positive">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBackBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Difference}" Value="0">
                                                        <Setter Property="Background" Value="{DynamicResource PositiveBackBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Difference, StringFormat={}{0:+0.##;-0.##;0}}" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PositiveTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Difference, Converter={StaticResource DiffSignConverter}}" Value="Negative">
                                                            <Setter Property="Foreground" Value="{DynamicResource NegativeTextBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Difference, Converter={StaticResource DiffSignConverter}}" Value="Positive">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="115" IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="Total Value" Width="145">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalValue, StringFormat=N2}" FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PositiveTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Difference, Converter={StaticResource DiffSignConverter}}" Value="Negative">
                                                        <Setter Property="Foreground" Value="{DynamicResource NegativeTextBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Difference, Converter={StaticResource DiffSignConverter}}" Value="Positive">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="115" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" Margin="4,12,4,0">
            <TextBlock x:Name="FooterText" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
        </Grid>
        </Grid>
    </Grid>
</Window>
