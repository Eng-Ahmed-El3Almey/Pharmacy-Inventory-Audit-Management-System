<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <RootNamespace>PharmacyInventorySystem</RootNamespace>
    <AssemblyName>PharmacyInventorySystem</AssemblyName>
    <ApplicationIcon>Assets\PharmacyInventory.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Used for real .xlsx import/export (Add Stock via Excel / Export Audit to Excel) -->
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
    <!-- Used for real PDF export (Export Audit to PDF) -->
    <PackageReference Include="QuestPDF" Version="2024.10.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicitly reference Windows Forms runtime without enabling global WinForms usings -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PharmacyInventory.ico" />
    <Content Include="Sounds\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
