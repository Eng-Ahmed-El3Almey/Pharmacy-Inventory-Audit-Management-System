<UserControl x:Class="PharmacyInventorySystem.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="CenteredDataGridTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ReportsLikeUserDataGrid" TargetType="DataGrid" BasedOn="{StaticResource ThemedDataGrid}">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="52"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
        </Style>

        <Style x:Key="ReportsLikeUserHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource TableHeaderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ReportsLikeUserRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHoverAccentBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHoverAccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReportsLikeUserCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedCellBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Page header: filled icon + title/description on the left, action on the right -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="48" Height="48"
                        CornerRadius="12"
                        Background="{DynamicResource AccentBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0">
                    <TextBlock Text="&#xE716;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource OnAccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="User Management"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{DynamicResource HeaderTextBrush}"/>
                    <TextBlock Text="Manage user accounts, access permissions and account status"
                               FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="16,10"
                        VerticalAlignment="Center"
                        Click="AddUser_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Margin="0,0,7,0"/>
                        <TextBlock Text="Add New User"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Table toolbar: Users/count on the left, search on the right -->
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="12,7"
                        MinWidth="110"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE77B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Users"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource HeaderTextBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="UserCountText"
                                   Text="0"
                                   Margin="7,0,0,0"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="10,0"
                        Width="250"
                        Height="40">
                    <Grid>
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox"
                                 Margin="26,0,0,0"
                                 Style="{StaticResource RoundedTextBoxStyle}"
                                 TextChanged="SearchBox_TextChanged"
                                 ToolTip="Search by username, name, email, mobile, role or gender"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

                <DataGrid x:Name="UsersGrid"
                          Grid.Row="1"
                          Margin="8,0,8,8"
                          Style="{StaticResource ReportsLikeUserDataGrid}"
                          ColumnHeaderStyle="{StaticResource ReportsLikeUserHeader}"
                          RowStyle="{StaticResource ReportsLikeUserRow}"
                          CellStyle="{StaticResource ReportsLikeUserCell}"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserResizeColumns="True"
                          HeadersVisibility="Column"
                          RowHeight="54">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="52"
                                              ElementStyle="{StaticResource CenteredDataGridTextStyle}"/>
                        <DataGridTemplateColumn Header="User" Width="1.55*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding FullName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HeaderTextBrush}"
                                                   TextAlignment="Left"
                                                   HorizontalAlignment="Left"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Username, StringFormat={}@{0}}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Margin="0,2,0,0"
                                                   TextAlignment="Left"
                                                   HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="1*"
                                              ElementStyle="{StaticResource CenteredDataGridTextStyle}"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.45*"
                                              ElementStyle="{StaticResource CenteredDataGridTextStyle}"/>
                        <DataGridTextColumn Header="Mobile" Binding="{Binding Mobile}" Width="1.15*"
                                              ElementStyle="{StaticResource CenteredDataGridTextStyle}"/>
                        <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="0.9*"
                                              ElementStyle="{StaticResource CenteredDataGridTextStyle}"/>
                        <DataGridTemplateColumn Header="Status" Width="0.9*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6"
                                            Padding="10,4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Inactive"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource NegativeTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="Active"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource PositiveTextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource NegativeBackBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PositiveBackBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Last Login" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LastLoginAt, StringFormat=dd/MM/yyyy HH:mm}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Actions" Width="330">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Button Content="&#xE70F;  Edit"
                                                FontFamily="Segoe UI, Segoe MDL2 Assets"
                                                Width="82"
                                                Height="34"
                                                Margin="0,0,7,0"
                                                ToolTip="Edit user"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Padding="0"
                                                Tag="{Binding}"
                                                Click="EditUser_Click"/>
                                        <Button Content="&#xE74D;  Delete"
                                                FontFamily="Segoe UI, Segoe MDL2 Assets"
                                                Width="92"
                                                Height="34"
                                                Margin="0,0,7,0"
                                                ToolTip="Delete user"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Padding="0"
                                                Tag="{Binding}"
                                                Click="DeleteUser_Click"/>
                                        <Button Content="&#xE777;  Status"
                                                FontFamily="Segoe UI, Segoe MDL2 Assets"
                                                Width="88"
                                                Height="34"
                                                ToolTip="Activate / deactivate user"
                                                Style="{StaticResource PillButtonBase}"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                Foreground="{DynamicResource BodyTextBrush}"
                                                BorderBrush="{DynamicResource BorderBrush2}"
                                                Padding="0"
                                                Tag="{Binding}"
                                                Click="ToggleUser_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
</UserControl>
