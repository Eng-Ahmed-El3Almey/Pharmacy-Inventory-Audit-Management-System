<Window x:Class="PharmacyInventorySystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign In"
        Width="900"
        Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        AllowsTransparency="False"
        SourceInitialized="LoginWindow_SourceInitialized"
        ShowInTaskbar="True">


    <Window.Resources>
        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginWindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource WindowButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource LoginWindowButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PasswordVisibilityButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="0"
            CornerRadius="18"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush2}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <!-- Brand panel -->
            <Border Grid.Column="0"
                    Margin="0"
                    CornerRadius="17,0,0,17"
                    Background="{DynamicResource SidebarBackgroundBrush}">
                <Grid Margin="42">
                    <StackPanel VerticalAlignment="Center">
                        <Border Width="76"
                                Height="76"
                                CornerRadius="38"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="34"
                                       Foreground="{DynamicResource OnAccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="PHARMACY INVENTORY"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,28,0,8"/>

                        <TextBlock Text="Inventory Audit &amp;&#10;Management System"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource HeaderTextBrush}"
                                   LineHeight="34"/>

                        <TextBlock Text="Secure access to your pharmacy inventory, audit reports and user management."
                                   FontSize="13"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,16,18,0"/>
                    </StackPanel>

                    <TextBlock Text="Authorized access only"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Bottom"/>
                </Grid>
            </Border>

            <!-- Login panel -->
            <Grid Grid.Column="1" Margin="44,30,38,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="&#xE921;"
                            Style="{StaticResource LoginWindowButtonStyle}"
                            ToolTip="Minimize"
                            Click="Minimize_Click"/>
                    <Button Content="&#xE8BB;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource LoginCloseButtonStyle}"
                            ToolTip="Close"
                            Click="Close_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            MaxWidth="370">
                    <TextBlock x:Name="LoginHeadingText"
                               Text="Welcome Back"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource HeaderTextBrush}"/>
                    <TextBlock x:Name="LoginDescriptionText"
                               Text="Sign in to continue"
                               FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,6,0,28"/>

                    <TextBlock Text="Username"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource HeaderTextBrush}"
                               Margin="1,0,0,7"/>
                    <TextBox x:Name="UsernameBox"
                             Style="{StaticResource LoginTextBoxStyle}"
                             KeyDown="Input_KeyDown"/>

                    <TextBlock Text="Password"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource HeaderTextBrush}"
                               Margin="1,18,0,7"/>
                    <Grid>
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource LoginPasswordBoxStyle}"
                                     Padding="14,0,48,0"
                                     KeyDown="Input_KeyDown"/>
                        <TextBox x:Name="PasswordTextBox"
                                 Style="{StaticResource LoginTextBoxStyle}"
                                 Padding="14,0,48,0"
                                 Visibility="Collapsed"
                                 KeyDown="Input_KeyDown"/>
                        <Button x:Name="PasswordVisibilityButton"
                                Content="&#xE890;"
                                Style="{StaticResource PasswordVisibilityButtonStyle}"
                                Width="34" Height="34"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                ToolTip="Show password"
                                Click="PasswordVisibility_Click"/>
                    </Grid>

                    <Border x:Name="ErrorPanel"
                            Background="{DynamicResource NegativeBackBrush}"
                            BorderBrush="{DynamicResource NegativeTextBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,14,0,0"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE783;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource NegativeTextBrush}"
                                       VerticalAlignment="Top"/>
                            <TextBlock x:Name="ErrorText"
                                       Grid.Column="1"
                                       FontSize="12"
                                       Foreground="{DynamicResource NegativeTextBrush}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <Button Content="&#xE72C;  Sign In"
                            Height="46"
                            Margin="0,20,0,0"
                            Style="{StaticResource AccentButtonStyle}"
                            FontFamily="Segoe UI, Segoe MDL2 Assets"
                            FontSize="14"
                            Click="Login_Click"/>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="Pharmacy Inventory Audit &amp; Management System  •  v1.0.0"
                           FontSize="10"
                           Foreground="{DynamicResource MutedTextBrush}"
                           HorizontalAlignment="Center"/>
            </Grid>
            <Grid x:Name="LoginLoadingOverlay"
                  Panel.ZIndex="100"
                  Background="{DynamicResource OverlayBrush}"
                  Visibility="Collapsed">
                <Border Width="360"
                        Padding="26"
                        CornerRadius="16"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Signing In"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource HeaderTextBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Checking your account and permissions..."
                                   FontSize="13"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,7,0,20"/>
                        <ProgressBar Height="8"
                                     IsIndeterminate="True"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
