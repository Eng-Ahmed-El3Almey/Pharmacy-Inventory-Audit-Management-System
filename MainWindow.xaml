<?xml version='1.0' encoding='UTF-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:PharmacyInventorySystem.ViewModels" xmlns:conv="clr-namespace:PharmacyInventorySystem.Converters" xmlns:local="clr-namespace:PharmacyInventorySystem" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" x:Class="PharmacyInventorySystem.MainWindow" Title="Pharmacy Inventory Audit &amp; Management System" Height="760" Width="1280" MinHeight="650" MinWidth="1100" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="False" Icon="/PharmacyInventorySystem;component/Assets/PharmacyInventory.ico" Loaded="MainWindow_Loaded" ResizeMode="CanResize" Background="{DynamicResource WindowBackgroundBrush}" AllowDrop="True" PreviewDragOver="MainWindow_PreviewDragOver" PreviewDrop="MainWindow_PreviewDrop" DragLeave="MainWindow_DragLeave" Closing="MainWindow_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="12" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <conv:DiffToBackgroundConverter x:Key="DiffToBackgroundConverter"/>

        <conv:DiffToForegroundConverter x:Key="DiffToForegroundConverter"/>

        <conv:DiffToSignedStringConverter x:Key="DiffToSignedStringConverter"/>

        <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>

        <conv:DiffSignConverter x:Key="DiffSignConverter"/>

        <DataTemplate x:Key="ActualQuantityCellTemplate">
            <Border CornerRadius="7" Padding="8,4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="4,2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCounted}" Value="False">
                                <Setter Property="Background" Value="{DynamicResource WarningBackBrush}"/>
                                <Setter Property="ToolTip" Value="Not counted yet"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Court, StringFormat=N2}" Foreground="{DynamicResource BodyTextBrush}" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Border>
        </DataTemplate>

        <Style x:Key="ActualQuantityEditBoxStyle" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBoxStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <DataTemplate x:Key="ActualQuantityEditingTemplate">
            <TextBox Text="{Binding Court, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ActualQuantityEditBoxStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
        </DataTemplate>

        <!-- Reports date picker: compact, white calendar with the app accent header. -->
        <Style x:Key="ReportsCalendarDayButtonStyle" TargetType="CalendarDayButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CalendarHoverBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsToday" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
                <Trigger Property="IsInactive" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource MutedAltBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReportsCalendarButtonStyle" TargetType="CalendarButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="ReportsCalendarItemStyle" TargetType="CalendarItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarItem">
                        <Grid x:Name="PART_Root" Background="{DynamicResource CardBackgroundBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="58"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource AccentBrush}" CornerRadius="8,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="PART_PreviousButton" Grid.Column="0" Content="" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource OnAccentBrush}" Background="Transparent" BorderThickness="0" Focusable="False"/>
                                        <Button x:Name="PART_HeaderButton" Grid.Column="1" Foreground="{DynamicResource OnAccentBrush}" Background="Transparent" BorderThickness="0" FontSize="16" FontWeight="SemiBold" HorizontalContentAlignment="Center"/>
                                        <Button x:Name="PART_NextButton" Grid.Column="2" Content="" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource OnAccentBrush}" Background="Transparent" BorderThickness="0" Focusable="False"/>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid x:Name="PART_MonthView" Margin="12,10,12,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                    </Grid>
                                    <Grid x:Name="PART_YearView" Margin="12,10,12,12" Visibility="Hidden">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    </Grid>
                                </Grid>

                                <Rectangle x:Name="PART_DisabledVisual" Grid.RowSpan="2" Fill="{DynamicResource CardBackgroundBrush}" Opacity="0" Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Resources>
                            <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                                <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                            </DataTemplate>
                        </ControlTemplate.Resources>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="PART_DisabledVisual" Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Year">
                                <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Decade">
                                <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportsCalendarStyle" TargetType="Calendar">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CalendarItemStyle" Value="{StaticResource ReportsCalendarItemStyle}"/>
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource ReportsCalendarDayButtonStyle}"/>
            <Setter Property="CalendarButtonStyle" Value="{StaticResource ReportsCalendarButtonStyle}"/>
        </Style>

        <!-- ================= Reports DatePicker ================= -->
        <!-- Matches the rounded ComboBox look used throughout the application. -->
        <Style x:Key="ReportsDatePickerTextBoxStyle" TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource HeaderTextBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionTextBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="12,0,6,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportsDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SelectedDateFormat" Value="Short"/>
            <Setter Property="CalendarStyle" Value="{StaticResource ReportsCalendarStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid>
                            <Border x:Name="DateChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" Style="{StaticResource ReportsDatePickerTextBoxStyle}" Foreground="{TemplateBinding Foreground}" IsReadOnly="False" VerticalContentAlignment="Center"/>

                                    <Button x:Name="PART_Button" Grid.Column="1" Width="36" Height="36" Margin="0" Padding="0" Focusable="False" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Open calendar">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonChrome" Background="Transparent" CornerRadius="0,7,7,0">
                                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.95"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="False" Focusable="False" PopupAnimation="Slide" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,6,0,0">
                                    <Calendar x:Name="PART_Calendar" Style="{TemplateBinding CalendarStyle}" DisplayDate="{Binding DisplayDate, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" DisplayDateStart="{TemplateBinding DisplayDateStart}" DisplayDateEnd="{TemplateBinding DisplayDateEnd}" FirstDayOfWeek="{TemplateBinding FirstDayOfWeek}" IsTodayHighlighted="{TemplateBinding IsTodayHighlighted}" SelectedDate="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" SelectionMode="SingleDate"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DateChrome" Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DateChrome" Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DateChrome" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DiffCellTemplate">
            <Border Style="{StaticResource DiffPillStyle}" Background="{Binding Diff, Converter={StaticResource DiffToBackgroundConverter}}">
                <TextBlock Text="{Binding Diff, Converter={StaticResource DiffToSignedStringConverter}}" Foreground="{Binding Diff, Converter={StaticResource DiffToForegroundConverter}}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource WindowBackgroundBrush}">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- =====================================================
                 Custom Title Bar
                 ===================================================== -->

            <Border Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid Margin="16,0">

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}">

                            <TextBlock Text="⚕" FontSize="14" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <TextBlock Text="Pharmacy Inventory Audit &amp; Management System" FontSize="15" FontWeight="Bold" Margin="10,0,0,0" Foreground="{DynamicResource TitleBarTextBrush}" VerticalAlignment="Center"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                        <ComboBox x:Name="ThemeSelector" Style="{StaticResource ThemeSelectorStyle}" SelectionChanged="ThemeSelector_SelectionChanged" Margin="0,0,10,0" ToolTip="Choose application theme">
                            <ComboBoxItem Content="Dark Theme"/>
                            <ComboBoxItem Content="Light Theme"/>
                            <ComboBoxItem Content="Blue Theme"/>
                        </ComboBox>

                        <Button Content="" Style="{StaticResource WindowControlButtonStyle}" Foreground="{DynamicResource TitleBarTextBrush}" Click="Minimize_Click"/>

                        <Button Content="" Style="{StaticResource WindowControlButtonStyle}" Foreground="{DynamicResource TitleBarTextBrush}" Click="MaximizeRestore_Click"/>

                        <Button Content="" Style="{StaticResource CloseButtonStyle}" Foreground="{DynamicResource TitleBarTextBrush}" Click="Close_Click"/>

                    </StackPanel>

                </Grid>
            </Border>

            <!-- =====================================================
                 Main Body
                 ===================================================== -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="220"/>

                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- =================================================
                     Sidebar
                     ================================================= -->

                <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">

                    <DockPanel>

                        <Border DockPanel.Dock="Top" Height="50" Cursor="Hand" Background="Transparent" PreviewMouseLeftButtonDown="SidebarToggle_MouseLeftButtonDown">

                            <TextBlock x:Name="SidebarToggleIcon" Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource SidebarTextBrush}" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">

                            <RadioButton x:Name="HomeNavItem" Style="{StaticResource NavItemStyle}" IsChecked="True" Click="HomeNavItem_Click">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22"/>

                                    <TextBlock x:Name="HomeLabel" Text="Inventory" VerticalAlignment="Center" Margin="6,0,0,0"/>

                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="ReportsNavItem" Style="{StaticResource NavItemStyle}" Click="ReportsNavItem_Click">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22"/>

                                    <TextBlock x:Name="ReportsNavLabel" Text="Reports" VerticalAlignment="Center" Margin="6,0,0,0"/>

                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="ItemMovementNavItem" Style="{StaticResource NavItemStyle}" Click="ItemMovementNavItem_Click">

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22"/>
                                    <TextBlock x:Name="ItemMovementNavLabel" Text="Item Movement" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="CategoriesNavItem" Style="{StaticResource NavItemStyle}" Click="CategoriesNavItem_Click">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22"/>

                                    <TextBlock x:Name="CategoriesNavLabel" Text="Categories" VerticalAlignment="Center" Margin="6,0,0,0"/>

                                </StackPanel>
                            </RadioButton>



                            <RadioButton x:Name="UserManagerNavItem" Style="{StaticResource NavItemStyle}" Click="UserManagerNavItem_Click">

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22"/>

                                    <TextBlock x:Name="UserManagerNavLabel" Text="User Manager" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </RadioButton>


                            <TextBlock x:Name="OptionsSectionLabel" Text="OPTIONS" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="18,14,0,6"/>

                            <Grid x:Name="UncountedOptionRow" Margin="18,3,14,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Show Uncounted Only" Foreground="{DynamicResource HeaderTextBrush}" FontSize="12" VerticalAlignment="Center" ToolTip="Show only products that have not been physically counted yet."/>
                                <ToggleButton Grid.Column="1" Style="{StaticResource OptionToggleStyle}" IsChecked="{Binding ShowUncountedOnly, Mode=TwoWay}" ToolTip="Show only products that have not been counted"/>
                            </Grid>

                            <Grid x:Name="ZeroStockOptionRow" Margin="18,3,14,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ZeroStockOptionLabel" Text="Show Zero Stock" Foreground="{DynamicResource HeaderTextBrush}" FontSize="12" VerticalAlignment="Center"/>

                                <ToggleButton Grid.Column="1" Style="{StaticResource OptionToggleStyle}" IsChecked="{Binding ShowZeroStock, Mode=TwoWay}" ToolTip="Show items with zero system stock"/>
                            </Grid>

                            <Grid x:Name="SummaryCardsOptionRow" Margin="18,3,14,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="SummaryCardsOptionLabel" Text="Show Summary Cards" Foreground="{DynamicResource HeaderTextBrush}" FontSize="12" VerticalAlignment="Center"/>

                                <ToggleButton Grid.Column="1" Style="{StaticResource OptionToggleStyle}" IsChecked="{Binding ShowSummaryCards, Mode=TwoWay}" ToolTip="Show or hide the three summary cards below the table"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource SecondarySurfaceBrush}" Margin="18,10"/>

                            <TextBlock x:Name="ExportSectionLabel" Text="EXPORT" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="18,0,0,8"/>

                            <Button x:Name="SaveAuditReportButton" Style="{StaticResource SidebarActionButtonStyle}" Command="{Binding SaveAuditReportCommand}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22"/>

                                    <TextBlock x:Name="SaveAuditReportLabel" Text="Save Audit Report" VerticalAlignment="Center" Margin="6,0,0,0"/>

                                </StackPanel>
                            </Button>

                            <Button x:Name="ClearStockButton" Style="{StaticResource SidebarActionButtonStyle}" Command="{Binding ClearInventoryCommand}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22"/>

                                    <TextBlock x:Name="ClearStockLabel" Text="Clear Stock" VerticalAlignment="Center" Margin="6,0,0,0"/>

                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarActionButtonStyle}" Command="{Binding ExportAuditExcelCommand}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22"/>

                                    <TextBlock x:Name="ExportExcelLabel" Text="Export Audit to Excel" VerticalAlignment="Center" Margin="6,0,0,0"/>

                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarActionButtonStyle}" Command="{Binding ExportAuditPdfCommand}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22"/>

                                    <TextBlock x:Name="ExportPdfLabel" Text="Export Audit to PDF" VerticalAlignment="Center" Margin="6,0,0,0"/>

                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarActionButtonStyle}" Click="ExportToImage_Click">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22"/>

                                    <TextBlock x:Name="ExportImageLabel" Text="Export to Image" VerticalAlignment="Center" Margin="6,0,0,0"/>

                                </StackPanel>
                            </Button>

                        </StackPanel>

                    </DockPanel>
                </Border>

                <!-- =================================================
                     Main Content
                     ================================================= -->

                <Grid x:Name="HomeContentGrid" Grid.Column="1" Margin="24">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- =================================================
                         Toolbar
                         ================================================= -->

                    <Grid Grid.Row="0" Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search -->

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,14,0">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">

                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="2,0,8,0"/>

                                    <Grid Margin="24,0,0,0">

                                        <TextBlock Text="Search by code, product name or price..." Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" FontSize="13" Visibility="{Binding SearchText, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>

                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBoxStyle}"/>

                                    </Grid>

                                </Grid>

                                <RadioButton Grid.Column="1" Content="Code" Style="{StaticResource PillRadioStyle}" GroupName="SearchMode" IsChecked="True" Margin="18,0,0,0" Checked="SearchModeCode_Checked"/>

                                <RadioButton Grid.Column="2" Content="Product Name" Style="{StaticResource PillRadioStyle}" GroupName="SearchMode" Margin="18,0,0,0" Checked="SearchModeName_Checked"/>

                                <RadioButton Grid.Column="3" Content="Price" Style="{StaticResource PillRadioStyle}" GroupName="SearchMode" Margin="18,0,0,0" Checked="SearchModePrice_Checked"/>

                            </Grid>
                        </Border>

                        <!-- =================================================
                             Branch / Warehouse
                             ================================================= -->

                        <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">

                            <TextBlock Text="Select Branch" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="2,0,0,4"/>

                            <ComboBox Width="220" Height="36" Style="{StaticResource RoundedComboBoxStyle}" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"/>

                        </StackPanel>

                        <!-- =================================================
                             Import
                             ================================================= -->

                        <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Command="{Binding ImportExcelCommand}">

                            <Button.Visibility>
                                <Binding Path="HasInventoryData">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Visibility>

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                <TextBlock Text="{Binding ImportButtonText}" VerticalAlignment="Center"/>

                            </StackPanel>
                        </Button>

                    </Grid>

                    <!-- =================================================
                         Single Inventory Table
                         ================================================= -->

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Table Header -->

                            <Grid Grid.Row="0" Margin="0,0,0,14">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBrush}"/>

                                    <TextBlock Text="Inventory Audit" FontWeight="Bold" FontSize="15" Margin="10,0,0,0" Foreground="{DynamicResource HeaderTextBrush}"/>

                                </StackPanel>

                                <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="10,4" HorizontalAlignment="Right">

                                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="12">

                                        <Run Text="Total Items: "/>
                                        <Run Text="{Binding FilteredCount, Mode=OneWay}"/>

                                    </TextBlock>

                                </Border>

                            </Grid>

                            <!-- =================================================
                                 Seven Columns Exactly
                                 ================================================= -->

                            <DataGrid x:Name="DetailedGrid" Grid.Row="1" Style="{StaticResource ThemedDataGrid}" BeginningEdit="DetailedGrid_BeginningEdit" PreviewKeyDown="DetailedGrid_PreviewKeyDown" PreviewMouseLeftButtonDown="DetailedGrid_PreviewMouseLeftButtonDown" ItemsSource="{Binding ProductsView}" IsReadOnly="False" AutoGenerateColumns="False" FontSize="14" ColumnHeaderHeight="42" RowHeight="42">

                                <DataGrid.Columns>

                                    <!-- 1. Code -->

                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="Auto" IsReadOnly="True"/>

                                    <!-- 2. Product Name -->

                                    <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>

                                    <!-- 3. System Quantity -->

                                    <DataGridTextColumn Header="System Quantity" Binding="{Binding System}" Width="Auto" IsReadOnly="True"/>

                                    <!-- 4. Actual Quantity -->

                                    <DataGridTemplateColumn Header="Actual Quantity" Width="Auto" CellTemplate="{StaticResource ActualQuantityCellTemplate}" CellEditingTemplate="{StaticResource ActualQuantityEditingTemplate}"/>

                                    <!-- 5. Difference -->

                                    <DataGridTemplateColumn Header="Difference" Width="Auto" CellTemplate="{StaticResource DiffCellTemplate}"/>

                                    <!-- 6. Selling Price -->

                                    <DataGridTextColumn Header="Selling Price" Binding="{Binding Price, StringFormat=N2}" Width="Auto" IsReadOnly="True"/>

                                    <!-- 7. Shortage / Surplus Value -->

                                    <DataGridTextColumn Header="Shortage / Surplus Value" Binding="{Binding Total, StringFormat=N2}" Width="Auto" IsReadOnly="True"/>

                                </DataGrid.Columns>

                            </DataGrid>

                            <!-- =================================================
                                 Empty State
                                 The application starts without inventory data.
                                 This overlay disappears after an Excel file is loaded.
                                 ================================================= -->
                            <Grid Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource WindowBackgroundBrush}" Visibility="{Binding EmptyStateVisibility}">

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource InputBackgroundBrush}">

                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Text="No Inventory Data" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource HeaderTextBrush}" HorizontalAlignment="Center" Margin="0,20,0,8"/>

                                    <TextBlock Text="Add an inventory Excel file to get started." FontSize="14" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/>

                                    <Border Margin="0,16,0,0" Padding="22,14" CornerRadius="10" BorderThickness="1.5" BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource InputBackgroundBrush}" AllowDrop="True">

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                            <TextBlock Text="Drag &amp; Drop Excel file here" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource HeaderTextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding ImportExcelCommand}" Margin="0,20,0,0" Padding="24,12">

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Add Stock via Excel" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- =================================================
                                 Summary Cards
                                 ================================================= -->

                            <Grid x:Name="SummaryCardsPanel" Grid.Row="2" Margin="0,14,0,0" Visibility="{Binding SummaryCardsVisibility}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Perfect Match -->

                                <Border Grid.Column="0" Background="{DynamicResource PositiveBackBrush}" BorderBrush="{DynamicResource PositiveTextBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10">

                                    <StackPanel>

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource PositiveTextBrush}" FontSize="13"/>

                                            <TextBlock Text="Perfect Match" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource PositiveTextBrush}"/>

                                        </StackPanel>

                                        <Grid Margin="0,6,0,0">

                                            <TextBlock Text="{Binding PerfectCount}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PositiveTextBrush}" HorizontalAlignment="Left"/>

                                            <TextBlock Text="{Binding PerfectPercent}" FontSize="12" Foreground="{DynamicResource PositiveTextBrush}" HorizontalAlignment="Right"/>

                                        </Grid>

                                    </StackPanel>
                                </Border>

                                <!-- Surplus -->

                                <Border Grid.Column="2" Background="{DynamicResource WarningBackBrush}" BorderBrush="{DynamicResource WarningTextBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10">

                                    <StackPanel>

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource WarningTextBrush}" FontSize="13"/>

                                            <TextBlock Text="Surplus / Overstock" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource WarningTextBrush}"/>

                                        </StackPanel>

                                        <Grid Margin="0,6,0,0">

                                            <TextBlock Text="{Binding SurplusValue, StringFormat={}{0:N2} EGP}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource WarningTextBrush}" HorizontalAlignment="Left"/>

                                            <TextBlock Text="{Binding SurplusPercent}" FontSize="12" Foreground="{DynamicResource WarningTextBrush}" HorizontalAlignment="Right"/>

                                        </Grid>

                                    </StackPanel>
                                </Border>

                                <!-- Deficit -->

                                <Border Grid.Column="4" Background="{DynamicResource NegativeBackBrush}" BorderBrush="{DynamicResource NegativeTextBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10">

                                    <StackPanel>

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource NegativeTextBrush}" FontSize="13"/>

                                            <TextBlock Text="Deficit / Shortage" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource NegativeTextBrush}"/>

                                        </StackPanel>

                                        <Grid Margin="0,6,0,0">

                                            <TextBlock Text="{Binding DeficitValue, StringFormat={}{0:N2} EGP}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource NegativeTextBrush}" HorizontalAlignment="Left"/>

                                            <TextBlock Text="{Binding DeficitPercent}" FontSize="12" Foreground="{DynamicResource NegativeTextBrush}" HorizontalAlignment="Right"/>

                                        </Grid>

                                    </StackPanel>
                                </Border>

                            </Grid>

    

                    <!-- Excel drag & drop visual overlay -->
                    <Grid x:Name="ExcelDragDropOverlay" Panel.ZIndex="150" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed" IsHitTestVisible="False">

                        <Border Margin="18" CornerRadius="18" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                            <Grid Margin="36">
                                <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeDashArray="7,5" Opacity="0.75" IsHitTestVisible="False"/>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <Border Width="76" Height="76" CornerRadius="22" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock x:Name="DragDropTitleText" Text="Drop Excel File Here" Margin="0,20,0,0" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource HeaderTextBrush}" HorizontalAlignment="Center"/>

                                    <TextBlock x:Name="DragDropSubtitleText" Text="Release to import inventory" Margin="0,8,0,0" FontSize="14" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/>

                                    <Border Margin="0,18,0,0" Padding="14,7" CornerRadius="10" Background="{DynamicResource InputBackgroundBrush}" HorizontalAlignment="Center">
                                        <TextBlock Text="Supported: .xlsx  •  .xlsm" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    </Grid>
                    </Border>

                    <!-- =================================================
                         Reports Dashboard
                         ================================================= -->
                    <!-- =================================================
                         Inventory Audit Reports
                         ================================================= -->
                    <!-- =================================================
                         Item Movement
                         ================================================= -->
                    <!-- =================================================
                         User Management
                         ================================================= -->
                    <!-- Excel import progress overlay -->
                    <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="300" Background="{DynamicResource OverlayBrush}" IsHitTestVisible="False" Visibility="{Binding LoadingVisibility}">

                        <Border Width="460" Padding="28" CornerRadius="16" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <StackPanel>
                                <TextBlock Text="Loading Inventory" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HeaderTextBrush}" HorizontalAlignment="Center"/>

                                <TextBlock Text="Please wait while the Excel file is being processed." FontSize="13" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,20"/>

                                <ProgressBar Height="12" Minimum="0" Maximum="1" Value="{Binding ImportProgressFraction, Mode=OneWay}"/>

                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="{Binding ImportProgressText}" FontSize="13" Foreground="{DynamicResource MutedTextBrush}"/>
                                    <TextBlock Text="{Binding ImportProgress, StringFormat={}{0}%}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource HeaderTextBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
            <Grid x:Name="ReportsContentGrid" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="24" Panel.ZIndex="200" Background="{DynamicResource WindowBackgroundBrush}" Visibility="Collapsed">

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,0,18">

                                <Grid Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource AccentBrush}" Margin="0,0,12,0">
                                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Inventory Audit Reports" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource HeaderTextBrush}"/>
                                            <TextBlock Text="View and manage all saved inventory audit sessions" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Content="  Refresh" Click="RefreshReports_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" FontFamily="Segoe UI, Segoe MDL2 Assets" Padding="18,9"/>
                                </Grid>

                                <!-- Filters -->
                                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.25*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Branch / Warehouse" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="2,0,0,5"/>
                                            <ComboBox x:Name="ReportBranchSelector" Height="38" Style="{StaticResource RoundedComboBoxStyle}" IsEditable="False" IsTextSearchEnabled="True" ToolTip="Select a branch or warehouse" SelectionChanged="ReportBranchSelector_SelectionChanged"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="From Date" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource HeaderTextBrush}" Margin="2,0,0,6"/>
                                            <DatePicker x:Name="ReportFromDate" Style="{StaticResource ReportsDatePickerStyle}" SelectedDateFormat="Short"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                            <TextBlock Text="To Date" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource HeaderTextBrush}" Margin="2,0,0,6"/>
                                            <DatePicker x:Name="ReportToDate" Style="{StaticResource ReportsDatePickerStyle}" SelectedDateFormat="Short"/>
                                        </StackPanel>

                                        <Button Grid.Column="3" Content="  Search" Click="SearchReports_Click" VerticalAlignment="Bottom" Height="40" MinWidth="130" Style="{StaticResource AccentButtonStyle}" FontFamily="Segoe UI, Segoe MDL2 Assets" Padding="18,0"/>
                                    </Grid>
                                </Border>

                                <!-- KPI cards -->
                                <UniformGrid Columns="6" Margin="0,0,0,16">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0" Padding="13">
                                        <StackPanel>
                                            <TextBlock Text="Total Shortage Value" FontSize="11" Foreground="{DynamicResource NegativeTextBrush}"/>
                                            <TextBlock x:Name="ReportShortageValueText" Text="0.00 EGP" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource NegativeTextBrush}" Margin="0,9,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Margin="3,0" Padding="13">
                                        <StackPanel>
                                            <TextBlock Text="Total Surplus Value" FontSize="11" Foreground="{DynamicResource WarningTextBrush}"/>
                                            <TextBlock x:Name="ReportSurplusValueText" Text="0.00 EGP" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WarningTextBrush}" Margin="0,9,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Margin="3,0" Padding="13">
                                        <StackPanel>
                                            <TextBlock Text="Net Difference" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock x:Name="ReportNetDifferenceText" Text="0.00 EGP" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,9,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Margin="3,0" Padding="13">
                                        <StackPanel>
                                            <TextBlock Text="Total Items" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock x:Name="ReportTotalItemsText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource HeaderTextBrush}" Margin="0,9,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Margin="3,0" Padding="13">
                                        <StackPanel>
                                            <TextBlock Text="Shortage Items" FontSize="11" Foreground="{DynamicResource NegativeTextBrush}"/>
                                            <TextBlock x:Name="ReportShortageItemsText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource NegativeTextBrush}" Margin="0,9,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Margin="6,0,0,0" Padding="13">
                                        <StackPanel>
                                            <TextBlock Text="Surplus Items" FontSize="11" Foreground="{DynamicResource PositiveTextBrush}"/>
                                            <TextBlock x:Name="ReportSurplusItemsText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PositiveTextBrush}" Margin="0,9,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Saved audit sessions -->
                                <Border Style="{StaticResource CardStyle}" Padding="12">
                                    <StackPanel>
                                        <Grid Margin="4,0,4,10">
                                            <TextBlock Text="Audit Sessions" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource HeaderTextBrush}"/>
                                            <TextBlock x:Name="ReportResultsText" Text="0 reports" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                        </Grid>

                                        <Grid Background="{DynamicResource TableHeaderBrush}" Height="42" MinWidth="1080">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.15*"/>
                                                <ColumnDefinition Width="1.45*"/>
                                                <ColumnDefinition Width="0.60*"/>
                                                <ColumnDefinition Width="0.95*"/>
                                                <ColumnDefinition Width="0.95*"/>
                                                <ColumnDefinition Width="0.75*"/>
                                                <ColumnDefinition Width="2.45*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Date &amp; Time" VerticalAlignment="Center" Margin="12,0" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource OnAccentBrush}"/>
                                            <TextBlock Grid.Column="1" Text="Branch / Warehouse" VerticalAlignment="Center" Margin="12,0" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource OnAccentBrush}"/>
                                            <TextBlock Grid.Column="2" Text="Items" VerticalAlignment="Center" Margin="12,0" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource OnAccentBrush}"/>
                                            <TextBlock Grid.Column="3" Text="Shortage Value" VerticalAlignment="Center" Margin="12,0" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource OnAccentBrush}"/>
                                            <TextBlock Grid.Column="4" Text="Surplus Value" VerticalAlignment="Center" Margin="12,0" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource OnAccentBrush}"/>
                                            <TextBlock Grid.Column="5" Text="Status" VerticalAlignment="Center" Margin="12,0" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource OnAccentBrush}"/>
                                            <TextBlock Grid.Column="6" Text="Action" VerticalAlignment="Center" Margin="12,0" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource OnAccentBrush}"/>
                                        </Grid>

                                        <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="AuditSessionsPanel"/>
                                        </ScrollViewer>

                                        <TextBlock x:Name="NoReportsText" Text="No saved audit reports were found for the selected filters." FontSize="13" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,26" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="ItemMovementContentGrid" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="24" Panel.ZIndex="205" Background="{DynamicResource WindowBackgroundBrush}" Visibility="Collapsed">
                        <local:ItemMovementView x:Name="ItemMovementViewControl"/>
                    </Grid>

                    <Grid x:Name="UserManagementContentGrid" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="24" Panel.ZIndex="210" Background="{DynamicResource WindowBackgroundBrush}" Visibility="Collapsed">
                        <local:UserManagementView x:Name="UserManagementViewControl"/>
                    </Grid>

                </Grid>

                <!-- Global application status bar -->
                <Border Grid.Row="2" Grid.ColumnSpan="2"
                        Background="{DynamicResource StatusBarBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="0,0,12,12"
                        Padding="14,0">
                    <Grid VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource OnlineDotBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="FooterOnlineText" Text="System Online"
                                       Foreground="{DynamicResource PositiveTextBrush}"
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>

                            <Border Width="1" Height="18" Background="{DynamicResource StatusBarSeparatorBrush}" Margin="14,0"/>

                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="CurrentUserText" Text="Signed in user"
                                       Foreground="{DynamicResource StatusBarPrimaryTextBrush}" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="Current signed-in user" VerticalAlignment="Center"/>
                            <TextBlock Text="  (" Foreground="{DynamicResource StatusBarSecondaryTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CurrentUserRoleText" Text="Staff" Foreground="{DynamicResource StatusBarSecondaryTextBrush}"
                                       FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Text=")" Foreground="{DynamicResource StatusBarSecondaryTextBrush}" FontSize="11" VerticalAlignment="Center"/>

                            <Border Width="1" Height="18" Background="{DynamicResource StatusBarSeparatorBrush}" Margin="14,0"/>

                            <Button x:Name="SwitchUserButton" Click="SwitchUser_Click"
                                    Background="Transparent" BorderThickness="0" Padding="8,4"
                                    Foreground="{DynamicResource StatusBarPrimaryTextBrush}" Cursor="Hand"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="Switch User">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="StatusButtonBackground" CornerRadius="7" Background="Transparent" Padding="8,4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="StatusButtonBackground" Property="Background" Value="{DynamicResource StatusBarHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="StatusButtonBackground" Property="Background" Value="{DynamicResource StatusBarHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE748;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{DynamicResource StatusBarPrimaryTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Switch User" Margin="7,0,0,0" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource StatusBarPrimaryTextBrush}"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="18" Background="{DynamicResource StatusBarSeparatorBrush}" Margin="10,0"/>

                            <Button x:Name="RestartApplicationButton" Click="RestartApplication_Click"
                                    Background="Transparent" BorderThickness="0" Padding="8,4"
                                    Foreground="{DynamicResource StatusBarPrimaryTextBrush}" Cursor="Hand"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="Restart Application">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="RestartButtonBackground" CornerRadius="7" Background="Transparent" Padding="8,4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RestartButtonBackground" Property="Background" Value="{DynamicResource StatusBarHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="RestartButtonBackground" Property="Background" Value="{DynamicResource StatusBarHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{DynamicResource StatusBarPrimaryTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Restart Application" Margin="7,0,0,0" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource StatusBarPrimaryTextBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="v1.0.0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource StatusBarSecondaryTextBrush}" FontSize="10"/>
                    </Grid>
                </Border>

        </Grid>
    </Border>
</Window>